react\\normaLK\\src\\components\\News\\Pagination.js",["96","97","98","99","100"],"import React, { useState, useEffect } from 'react'\r\n\r\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\r\n\tconst [counter, setCounter] = useState(1)\r\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\reducers\\index.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\reducers\\getUserData.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\constants.js",[],"D:\\projects\\react\\normaLK\\src\\point.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\actions\\index.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\actions\\getUserData.js",[],{"ruleId":"101","severity":1,"message":"102","line":14,"column":6,"nodeType":"103","endLine":14,"endColumn":35,"suggestions":"104"},{"ruleId":"105","replacedBy":"106"},{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","severity":1,"message":"110","line":3,"column":10,"nodeType":"111","messageId":"112","endLine":3,"endColumn":17},{"ruleId":"109","severity":1,"message":"113","line":13,"column":8,"nodeType":"111","messageId":"112","endLine":13,"endColumn":16},{"ruleId":"109","severity":1,"message":"114","line":14,"column":8,"nodeType":"111","messageId":"112","endLine":14,"endColumn":13},{"ruleId":"109","severity":1,"message":"115","line":1,"column":17,"nodeType":"111","messageId":"112","endLine":1,"endColumn":26},{"ruleId":"109","severity":1,"message":"116","line":111,"column":8,"nodeType":"111","messageId":"112","endLine":111,"endColumn":13},{"ruleId":"109","severity":1,"message":"117","line":2,"column":10,"nodeType":"111","messageId":"112","endLine":2,"endColumn":24},{"ruleId":"109","severity":1,"message":"118","line":7,"column":10,"nodeType":"111","messageId":"112","endLine":7,"endColumn":20},{"ruleId":"109","severity":1,"message":"119","line":5,"column":26,"nodeType":"111","messageId":"112","endLine":5,"endColumn":44},{"ruleId":"101","severity":1,"message":"120","line":10,"column":5,"nodeType":"103","endLine":10,"endColumn":14,"suggestions":"121"},{"ruleId":"122","severity":1,"message":"123","line":32,"column":7,"nodeType":"124","endLine":32,"endC