er\"\r\n\t\t\t\t\t\t\t\tdisplay=\"inline\"\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{!MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.{props.userData.city}</p>}\r\n\t\t\t\t\t\t\t</Typography>\r\n\t\t\t\t\t\t</Grid>\r\n\t\t\t\t\t\t<Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n\t\t\t\t\t\t\t<Typography\r\n\t\t\t\t\t\t\t\tclassName={classes.root}\r\n\t\t\t\t\t\t\t\tvariant=\"body1\"\r\n\t\t\t\t\t\t\t\tcolor=\"textSecondary\"\r\n\t\t\t\t\t\t\t\tcomponent=\"p\"\r\n\t\t\t\t\t\t\t\talign=\"center\"\r\n\t\t\t\t\t\t\t\tdisplay=\"inline\"\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{!MobileVersionPlatform && <p className=\"itemsPlatfrom\">{props.userData.gender == 'Male' ? 'Мужчина' : 'Женщина'}</p>}\r\n\t\t\t\t\t\t\t</Typography>\r\n\t\t\t\t\t\t</Grid>\r\n\t\t\t\t\t</Grid>\r\n\t\t\t\t</CardContent>\r\n\t\t\t</CardActionArea>\r\n\t\t</Card>\r\n\t)\r\n}\r\n","D:\\projects\\react\\normaLK\\src\\components\\Header\\Header.js",[],"D:\\projects\\react\\normaLK\\src\\components\\News\\News.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Footer\\footer.js",[],"D:\\projects\\react\\normaLK\\src\\components\\News\\Pagination.js",["133"],"import React, { useState, useEffect } from 'react'\r\n\r\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\r\n\tconst [counter, setCounter] = useState(1)\r\n\tconst [numberOfButtons] = useState(Math.ceil(total / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<span style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<span\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</span>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<span style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Profile\\UpdateProfile.js",[],{"ruleId":"134","replacedBy":"135"},{"ruleId":"136","replacedBy":"137"},{"ruleId":"138","severity":1,"message":"139","line":17,"column":5,"nodeType":"140","endLine":17,"endColumn":73,"suggestions":"141"},{"ruleId":"138","severity":1,"message":"142","line":17,"column":15,"nodeType":"143","endLine":17,"endColumn":51},{"ruleId":"144","severity":1,"message":"145","line":43,"column":18,"nodeType":"146","messageId":"147","endLine":43,"endColumn":20},{"ruleId":"144","severity":1,"message":"145","line":115,"column":34,"nodeType":"146","messageId":"147","endLine":115,"endColumn":36},{"ruleId":"144","severity":1,"message":"145","line":180,"column":88,"nodeType":"146","messageId":"147","endLine":180,"endColumn":90},{"ruleId":"138","severity":1,"message":"148","line":10,"column":5,"nodeType":"140","endLine":10,"endColumn":14,"suggestions":"149"},"no-native-reassign",["150"],"no-negated-in-lhs",["151"],"react-hooks/exhaustive-deps","React Hook React.useEffect has a missing dependency: 'dispatch'. Either include it or remove the dependency array. Outer scope values like 'getData' aren't valid dependencies because mutating them doesn't re-render the component.","ArrayExpression",["152"],"React Hook React.useEffect has a complex expression in the dependency array. Extract it to a separate variable so it can be statically checked.","CallExpression","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","unexpected","React Hook useEffect has missing dependencies: 'onPaginationChange' and 'showPerPage'. Either include them or remove the dependency array. If 'onPaginationChange' changes too often, find the parent component that defines it and wrap that definition in useCallback.",["153"],"no-global-assign","no-unsafe-negation",{"desc":"154","fix":"155"},{"desc":"156","fix":"157"},"Update the dependencies array to be: [token, dispatch]",{"range":"158","text":"159"},"Update the dependencies array to be: [counter, onPaginationChange, showPerPage]",{"range":"160","text":"161"},[753,821],"[token, dispatch]",[352,361],"[counter, onPaginationChange, showPerPage]"]