bel=\"Номер телефона\"\r\n                        fullWidth/>\r\n                </Grid>\r\n                <Grid item xs={12} sm={6}>\r\n                    <TextField\r\n                        required\r\n                        onChange={onChange}\r\n                        name=\"birthday\"\r\n                        label=\"Дата рождения\"\r\n                        fullWidth/>\r\n                </Grid>\r\n                <Grid item xs={12} sm={6}>\r\n                    <TextField\r\n                        required\r\n                        onChange={onChange}\r\n                        name=\"birthday\"\r\n                        label=\"Пол\"\r\n                        fullWidth/>\r\n                </Grid>\r\n                <Grid item xs={12} sm={6}>\r\n                    <TextField\r\n                        required\r\n                        type=\"password\"\r\n                        onChange={onChange}\r\n                        name=\"birthday\"\r\n                        label=\"Пароль\"\r\n                        fullWidth/>\r\n                </Grid>\r\n                <Grid item xs={12} sm={6}>\r\n                    <TextField\r\n                        required\r\n                        type=\"password\"\r\n                        onChange={onChange}\r\n                        name=\"birthday\"\r\n                        label=\"Пароль 2\"\r\n                        fullWidth/>\r\n                </Grid>\r\n            </Grid><br/>\r\n            <Box pb={2}>\r\n                <Button\r\n                    fullWidth\r\n                    onClick={actions.register}\r\n                    variant=\"contained\"\r\n                    color=\"primary\"\r\n                    type=\"submit\"\r\n                >\r\n                    Войти\r\n                </Button>\r\n            </Box>\r\n        </React.Fragment>\r\n    );\r\n}","D:\\projects\\react\\normaLK\\src\\components\\Header\\Header.js",[],"D:\\projects\\react\\normaLK\\src\\