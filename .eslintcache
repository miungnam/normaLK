splay: 'flex',\r\n    justifyContent: 'flex-end',\r\n  },\r\n  button: {\r\n    marginTop: theme.spacing(3),\r\n    marginLeft: theme.spacing(1),\r\n  },\r\n  back: {\r\n  }\r\n}));\r\n\r\nexport default function Registrationn(props) {\r\n  const classes = useStyles();\r\n  return (\r\n    <div className=\"login-body\">\r\n      <CssBaseline />\r\n      <AppBar position=\"absolute\" color=\"default\" className={classes.appBar}>\r\n      </AppBar>\r\n      <main className={classes.layout}>\r\n        <Paper className={classes.paper}>\r\n          <Typography className={classes.mainTittle} component=\"h2\" variant=\"h4\" align=\"center\">\r\n            Регистрация\r\n          </Typography>\r\n          <React.Fragment>\r\n            <Registration {...props} />\r\n          </React.Fragment>\r\n        </Paper>\r\n      </main>\r\n    </div>\r\n  );\r\n}","D:\\projects\\react\\normaLK\\src\\redux\\actions\\RegisteAction\\register.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\actions\\LoginAction\\login.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\reducers\\utils\\base.js",["146"],"export default function (handlers, defaultState = {}) {\r\n    return abstractReducer.bind(null, handlers, defaultState);\r\n}\r\n\r\nfunction abstractReducer(handlers, defaultState, state, action) {\r\n    return handlers[action.type] ? handlers[action.type](state, action) : (state || defaultState);\r\n}\r\n\r\n\r\nexport function updateReducer(oldState, updatedProperties) {\r\n    return {\r\n        ...oldState,\r\n        ...updatedProperties\r\n    }\r\n\r\n}","D:\\projects\\react\\normaLK\\src\\components\\Registr\\Registration.js",["147","148","149","150","151","152","153"],"import React from 'react';\r\nimport Grid from '@material-ui/core/Grid';\r\nimport TextField from '@material-ui/core/TextField';\r\nimport FormControlLabel from '@material-ui/core/FormControlLabel';\r\nimport FormControl from '@material-ui/core/FormControl';\r\nimport FormLabel from '@material-ui/core/F