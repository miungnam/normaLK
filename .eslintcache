} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                <p className=\"categoryItem\">Номер телефона:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">+996703878545</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root3} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                <p className=\"categoryItem\">Дата рождения:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">15.10.1998</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root4} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                <p className=\"categoryItem\">Город:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.Бишкек</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root5} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                <p className=\"categoryItem\">Пол:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">Мужчина</p>}\n              </Typography>\n            </Grid>\n          </Grid>\n\n          <Grid\n            container\n            direction=\"row\"\n            justify=\"space-between\"\n            alignItems=\"baseline\"\n          >\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">emir.azimov@gmail.com</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+996703878545</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+15.10.1998</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.Бишкек</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">Мужчина</p>}\n              </Typography>\n            </Grid>\n          </Grid>\n        </CardContent>\n      </CardActionArea>\n    </Card>\n  );\n}\n","/home/baxa/staj/ww/normaLK/src/components/Footer/footer.js",[],"/home/baxa/staj/ww/normaLK/src/redux/constant/storage_key.js",[],"/home/baxa/staj/ww/normaLK/src/components/News/Pagination.js",["106","107","108","109","110"],"import React, { useState, useEffect } from 'react'\n\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\n\tconst [counter, setCounter] = useState(1)\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\n\n\tuseEffect(() => {\n\t\tconst value = showPerPage * counter\n\t\tonPaginationChange(value - showPerPage, value)\n\t}, [counter])\n\n\tconst onButtonClick = (type) => {\n\t\tif (type === 'prev') {\n\t\t\tif (counter === 1) {\n\t\t\t\tsetCounter(1)\n\t\t\t} else {\n\t\t\t\tsetCounter(counter - 1)\n\t\t\t}\n\t\t} else if (type === 'next') {\n\t\t\tif (numberOfButtons === counter) {\n\t\t\t\tsetCounter(counter)\n\t\t\t} else {\n\t\t\t\tsetCounter(counter + 1)\n\t\t\t}\n\t\t}\n\t}\n\treturn (\n\t\t<div className=\"d-flex justify-content-center\">\n\t\t\t<nav aria-label=\"Page navigation example\">\n\t\t\t\t<ul className=\"pagination\">\n\t\t\t\t\t<li className=\"page-item\">\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</li>\n\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\n\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{index + 1}\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t))}\n\t\t\t\t\t<li className=\"page-item\">\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</nav>\n\t\t</div>\n\t)\n}\n\nexport default Pagination\n","/home/baxa/staj/ww/normaLK/src/products.js",[],{"ruleId":"111","replacedBy":"112"},{"ruleId":"113","replacedBy":"114"},{"ruleId":"115","severity":1,"message":"116","line":111,"column":8,"nodeType":"117","messageId":"118","endLine":111,"endColumn":13},{"ruleId":"115","severity":1,"message":"119","line":114,"column":9,"nodeType":"117","messageId":"118","endLine":114,"endColumn":13},{"ruleId