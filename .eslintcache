nents/Login/Login.js",[],"/home/baxa/staj/normaLK/src/components/Sidebar/Sidebar.js",["88"],"/home/baxa/staj/normaLK/src/redux/reducers/utils/base.js",["89"],"export default function (handlers, defaultState = {}) {\n    return abstractReducer.bind(null, handlers, defaultState);\n}\n\nfunction abstractReducer(handlers, defaultState, state, action) {\n    return handlers[action.type] ? handlers[action.type](state, action) : (state || defaultState);\n}\n\n\nexport function updateReducer(oldState, updatedProperties) {\n    return {\n        ...oldState,\n        ...updatedProperties\n    }\n\n}","/home/baxa/staj/normaLK/src/redux/actions/LoginAction/login.js",[],"/home/baxa/staj/normaLK/src/components/News/News.js",[],"/home/baxa/staj/normaLK/src/components/ContactInfo/ContactInfo.js",["90","91"],"import React from 'react'\nimport { createMuiTheme, makeStyles } from '@material-ui/core/styles';\nimport Card from '@material-ui/core/Card';\nimport CardActionArea from '@material-ui/core/CardActionArea';\nimport CardContent from '@material-ui/core/CardContent';\nimport Typography from '@material-ui/core/Typography';\nimport { withStyles } from '@material-ui/core/styles/withStyles';\nimport { useMediaQuery, Grid} from '@material-ui/core';\nimport './ContactInfo.css'\n\nconst useStyles = makeStyles({\n  root: {\n    maxwidth: 2000,\n    disableRipple: true,\n    background: 'white'\n  },\n  root1: {\n    //textDecoration: 'underline'\n  },\n  root2: {\n    disableRipple: true,\n    //textDecoration: 'underline'\n  },\n  root3: {\n    //textDecoration: 'underline'\n  },\n  root4: {\n    //textDecoration: 'underline'\n  },\n  root5: {\n    //textDecoration: 'underline'\n  },\n\n  media: {\n    maxheight: 1200,\n  },\n})\n\n\nexport default function ContactInfo(props) {\n  const classes = useStyles();\n\n  const MobileVersionPlatform = useMediaQuery('(max-width:950px)')\n\n  return (\n\n    <Card className={classes.root} >\n      <CardActionArea >\n        <CardContent className={classes.roott} >\n          <Grid item xs={12} sm={12} xl={12} lg={12} md={12} container justify=\"center\">\n            <Typography gutterBottom variant=\"h5\" component=\"h2\">\n              <p className=\"mainTitle\">Контактная информация</p>\n            </Typography>\n          </Grid>\n          <Grid\n            container\n            direction=\"row\"\n            justify=\"space-between\"\n            alignItems=\"baseline\"\n          >\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root1} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                <p className=\"categoryItem\">Email/Соц.сети:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">emir.azimov@gmail.com</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root2} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                <p className=\"categoryItem\">Номер телефона:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">+996703878545</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root3} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                <p className=\"categoryItem\">Дата рождения:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">15.10.1998</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root4} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                <p className=\"categoryItem\">Город:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.Бишкек</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n              <Typography className={classes.root5} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                <p className=\"categoryItem\">Пол:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">Мужчина</p>}\n              </Typography>\n            </Grid>\n          </Grid>\n\n          <Grid\n            container\n            direction=\"row\"\n            justify=\"space-between\"\n            alignItems=\"baseline\"\n          >\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">emir.azimov@gmail.com</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+996703878545</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+15.10.1998</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.Бишкек</p>}\n              </Typography>\n            </Grid>\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">Мужчина</p>}\n              </Typography>\n            </Grid>\n          </Grid>\n        </CardContent>\n      </CardActionArea>\n    </Card>\n  );\n}\n","/home/baxa/staj/normaLK/src/components/Header/Header.js",[],"/home/baxa/staj/normaLK/src/redux/constant/storage_key.js",[],"/home/baxa/staj/normaLK/src/components/News/Pagination.js",["92","93","94","95","96"],"import React, { useState, useEffect } from 'react'\n\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\n\tconst [counter, setCounter] = useState(1)\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\n\n\tuseEffect(() => {\n\t\tconst value = showPerPage * counter\n\t\tonPaginationChange(value - showPerPage, value)\n\t}, [counter])\n\n\tconst onButtonClick = (type) => {\n\t\tif (type === 'prev') {\n\t\t\tif (counter === 1) {\n\t\t\t\tsetCounter(1)\n\t\t\t} else {\n\t\t\t\tsetCounter(counter - 1)\n\t\t\t}\n\t\t} else if (type === 'next') {\n\t\t\tif (numberOfButtons === counter) {\n\t\t\t\tsetCounter(counter)\n\t\t\t} else {\n\t\t\t\tsetCounter(counter + 1)\n\t\t\t}\n\t\t}\n\t}\n\treturn (\n\t\t<div className=\"d-flex justify-content-center\">\n\t\t\t<nav aria-label=\"Page navigation example\">\n\t\t\t\t<ul className=\"pagination\">\n\t\t\t\t\t<li className=\"page-item\">\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</li>\n\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\n\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t{index + 1}\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t))}\n\t\t\t\t\t<li className=\"page-item\">\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</nav>\n\t\t</div>\n\t)\n}\n\nexport default Pagination\n","/home/baxa/staj/normaLK/src/products.js",[],"/home/baxa/staj/normaLK/src/components/Footer/Footer.js",[],{"ruleId":"97","replacedBy":"98"},{"ruleId":"99","replacedBy":"100"},{"ruleId":"101","severity":1,"message":"102","line":112,"column":11,"nodeType":"103","messageId":"104","endLine":112,"endColumn":16},{"ruleId":"105","severity":1,"message":"106","line":1,"column":1,"nodeType":"107","endLine":3,"endColumn":2},{"ruleId":"101","severity":1,"message":"108","line":2,"column":10,"nodeType":"103","messageId":"104","endLine":2,"endColumn":24},{"ruleId":"101","severity":1,"message":"109","line":7,"column":10,"nodeType":"103","messageId":"104","endLine":7,"endColumn":20},{"ruleId":"101","severity":1,"message":"110","line":5,"column":26,"nodeType":"103","messageId":"104","endLine":5,"endColumn":44},{"ruleId":"111","severity":1,"message":"112","line":10,"column":5,"nodeType":"113","endLine":10,"endColumn":14,"suggestions":"114"},{"ruleId":"115","severity":1,"message":"116","line":32,"column":7,"nodeType":"117","endLine":32,"endColumn":100},{"ruleId":"115","severity":1,"message":"116","line":39,"column":8,"nodeType":"117","endLine":43,"endColumn":9},{"ruleId":"115","severity":1,"message":"116","line":49,"column":7,"nodeType":"117","endLine":49,"endColumn":100},"no-native-reassign",["118"],"no-negated-in-lhs",["119"],"no-unused-vars","'theme' is assigned a value but never used.","Identifier","unusedVar","import/no-anonymous-default-export","Unexpected default export of anonymous function","ExportDefaultDeclaration","'createMuiTheme' is defined but never used.","'withStyles' is defined but never used.","'setNumberOfButoons' is assigned a value but never used.","react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'onPaginationChange' and 'showPerPage'. Either include them or remove the dependency array. If 'onPaginationChange' changes too often, find the parent component that defines it and wrap that definition in useCallback.","ArrayExpression",["120"],"jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation",{"desc":"121","fix":"122"},"Update the dependencies array to be: [counter, onPaginationChange, showPerPage]",{"range":"123","text":"124"},[363,372],"[counter, onPaginationChange, showPerPage]"]