rc\\components\\News\\News.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Footer\\footer.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\constant\\storage_key.js",[],"D:\\projects\\react\\normaLK\\src\\products.js",[],"D:\\projects\\react\\normaLK\\src\\components\\News\\Pagination.js",["156","157","158","159","160"],"import React, { useState, useEffect } from 'react'\r\n\r\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\r\n\tconst [counter, setCounter] = useState(1)\r\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\components\\Profile\\Profile.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Docs\\Docs.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Otchets\\Otchets.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Machines\\Machines.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Casses\\casses.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Companies\\Companies.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Todos\\Todos.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Calendar\\Calendar.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Contacts\\Contacts.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Employees\\Employees.js",[],{"ruleId":"161","replacedBy":"162"},{"ruleId":"163","replacedBy":"164"},{"ruleId":"165","severity":1,"message":"166","line":5,"column":8,"nodeType":"167","messageId":"168","endLine":5,"endColumn":12},{"ruleId":"165","severity":1,"message":"169","line":1,"column":17,"nodeType":"167","messageId":"168","endLine":1,"endColumn":26},{"ruleId":"165","severity":1,"message":"170","line":3,"column":25,"nodeType":"167","messageId":"168","endLine":3,"endColumn":33},{"ruleId":"165","severity":1,"message":"171","line":16,"column":8,"nodeType":"167","messageId":"168","endLine":16,"endColumn":17},{"ruleId":"165","severity":1,"message":"172","line":17,"column":8,"nodeType":"167","messageId":"168","endLine":17,"endColumn":16},{"ruleId":"165","severity":1,"message":"173","line":128,"column":8,"nodeType":"167","messageId":"168","endLine":128,"endColumn":13},{"ruleId":"165","severity":1,"message":"174","line":6,"column":8,"nodeType":"167","message