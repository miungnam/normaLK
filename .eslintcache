werOpen : handleDrawerClose}>\n\t\t\t\t\t\t\t\t{open === false ? (\n\t\t\t\t\t\t\t\t\t<MenuIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t) : (\n\t\t\t\t\t\t\t\t\t<ChevronLeftIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t)}\n\t\t\t\t\t\t\t</IconButton>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<Divider />\n\t\t\t\t\t\t<List className={classes.toolbar2}>\n\t\t\t\t\t\t\t{['Главная', 'Starred', 'Send email', 'Drafts'].map((text, index) => (\n\t\t\t\t\t\t\t\t<ListItem button key={text}>\n\t\t\t\t\t\t\t\t\t<ListItemIcon>\n\t\t\t\t\t\t\t\t\t\t{index % 2 === 0 ? (\n\t\t\t\t\t\t\t\t\t\t\t<InboxIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t\t\t) : (\n\t\t\t\t\t\t\t\t\t\t\t<MailIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t\t\t)}\n\t\t\t\t\t\t\t\t\t</ListItemIcon>\n\t\t\t\t\t\t\t\t\t<ListItemText primary={text} />\n\t\t\t\t\t\t\t\t</ListItem>\n\t\t\t\t\t\t\t))}\n\t\t\t\t\t\t</List>\n\t\t\t\t\t\t<Divider />\n\t\t\t\t\t\t<List className={classes.toolbar3}>\n\t\t\t\t\t\t\t{['All mail', 'Trash', 'Spam'].map((text, index) => (\n\t\t\t\t\t\t\t\t<ListItem button key={text}>\n\t\t\t\t\t\t\t\t\t<ListItemIcon>\n\t\t\t\t\t\t\t\t\t\t{index % 2 === 0 ? (\n\t\t\t\t\t\t\t\t\t\t\t<InboxIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t\t\t) : (\n\t\t\t\t\t\t\t\t\t\t\t<MailIcon style={{ color: 'white' }} />\n\t\t\t\t\t\t\t\t\t\t)}\n\t\t\t\t\t\t\t\t\t</ListItemIcon>\n\t\t\t\t\t\t\t\t\t<ListItemText primary={text} />\n\t\t\t\t\t\t\t\t</ListItem>\n\t\t\t\t\t\t\t))}\n\t\t\t\t\t\t</List>\n\t\t\t\t\t</div>\n\t\t\t\t</Drawer>\n\t\t\t)}\n\n\t\t\t<main className={classes.content}>\n\t\t\t\t{MobileVersionPlatform && (\n\t\t\t\t\t<div  className={classes.root2}>\n\t\t\t\t\t\t<Accordion style={{background:\"linear-gradient(rgb(55, 79, 107) 41.15%, rgba(55, 79, 107, 0.64) 100%)\",marginTop:\"-10px\"}}>\n\t\t\t\t\t\t\t<AccordionSummary\n\t\t\t\t\t\t\t\taria-controls=\"panel1a-content\"\n\t\t\t\t\t\t\t\tid=\"panel1a-header\"\n\t\t\t\t\t\t\t\texpandIcon={<ExpandMoreIcon style={{color:\"white\"}} />}\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<MenuIcon style={{color:\"white\"}}/>\n\t\t\t\t\t\t\t\t<Typography style={{color:\"white\"}} className={classes.mobileTitle}>Личный кабинет</Typography>\n\t\t\t\t\t\t\t</AccordionSummary>\n\t\t\t\t\t\t\t<Divider />\n\t\t\t\t\t\t\t<List style={{color:\"white\"}}>\n\t\t\t\t\t\t\t\t{['Inbox', 'Starred', 'Send email', 'Drafts'].map((text, index) => (\n\t\t\t\t\t\t\t\t\t<ListItem button key={text}>\n\t\t\t\t\t\t\t\t\t\t<ListItemText primary={text} />\n\t\t\t\t\t\t\t\t\t</ListItem>\n\t\t\t\t\t\t\t\t))}\n\t\t\t\t\t\t\t</List>\n\t\t\t\t\t\t</Accordion>\n\t\t\t\t\t</div>\n\t\t\t\t)}\n\t\t\t\t<div>\n\t\t\t\t\t<Header />\n\t\t\t\t\t<br />\n\t\t\t\t\t<ContactInfo />\n\t\t\t\t\t<News />\n\t\t\t\t\t<Footer />\n\t\t\t\t</div>\n\t\t\t</main>\n\t\t</div>:<div>Не зарегистрирован</div>\n\t)\n}\n","/home/baxa/staj/ww/normaLK/src/components/Login/Login.js",[],"/home/baxa/staj/ww/normaLK/src/components/Registr/Registrationn.js",[],"/home/baxa/staj/ww/normaLK/src/redux/actions/LoginAction/login.js",[],"/home/baxa/staj/ww/normaLK/src/redux/reducers/utils/base.js",["103"],"export default function (handlers, defaultState = {}) {\n    return abstractReducer.bind(null, handlers, defaultState);\n}\n\nfunction abstractReducer(handlers, defaultState, state, action) {\n    return handlers[action.type] ? handlers[action.type](state, action) : (state || defaultState);\n}\n\n\nexport function updateReducer(oldState, updatedProperties) {\n    return {\n        ...oldState,\n        ...updatedProperties\n    }\n\n}","/home/baxa/staj/ww/normaLK/src/components/Registr/Registration.js",[],"/home/baxa/staj/ww/normaLK/src/components/Header/Header.js",[],"/home/baxa/staj/ww/normaLK/src/components/News/News.js",[],"/home/baxa/staj/ww/normaLK/src/components/ContactInfo/ContactInfo.js",["104","105"],"import React from 'react'\nimport { createMuiTheme, makeStyles } from '@material-ui/core/styles';\nimport Card from '@material-ui/core/Card';\nimport CardActionArea from '@