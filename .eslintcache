VersionPlatform && <p className=\"itemsPlatfrom\">{props.userData.email}</p>}\n\t\t\t\t\t\t\t</Typography>\n\t\t\t\t\t\t</Grid>\n\t\t\t\t\t\t<Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n\t\t\t\t\t\t\t<Typography\n\t\t\t\t\t\t\t\tclassName={classes.root2}\n\t\t\t\t\t\t\t\tvariant=\"body1\"\n\t\t\t\t\t\t\t\tcolor=\"textSecondary\"\n\t\t\t\t\t\t\t\tcomponent=\"p\"\n\t\t\t\t\t\t\t\talign=\"center\"\n\t\t\t\t\t\t\t\tdisplay=\"inline\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<p className=\"categoryItem\">Номер телефона:</p>\n\t\t\t\t\t\t\t\t{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{props.userData.phone}</p>}\n\t\t\t\t\t\t\t</Typography>\n\t\t\t\t\t\t</Grid>\n\t\t\t\t\t\t<Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n\t\t\t\t\t\t\t<Typography\n\t\t\t\t\t\t\t\tclassName={classes.root3}\n\t\t\t\t\t\t\t\tvariant=\"body1\"\n\t\t\t\t\t\t\t\tcolor=\"textSecondary\"\n\t\t\t\t\t\t\t\tcomponent=\"p\"\n\t\t\t\t\t\t\t\talign=\"center\"\n\t\t\t\t\t\t\t\tdisplay=\"inline\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<p className=\"categoryItem\">Дата рождения:</p>\n\t\t\t\t\t\t\t\t{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{props.userData.birthday}</p>}\n\t\t\t\t\t\t\t</Typography>\n\t\t\t\t\t\t</Grid>\n\t\t\t\t\t\t<Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n\t\t\t\t\t\t\t<Typography\n\t\t\t\t\t\t\t\tclassName={classes.root4}\n\t\t\t\t\t\t\t\tvariant=\"body1\"\n\t\t\t\t\t\t\t\tcolor=\"textSecondary\"\n\t\t\t\t\t\t\t\tcomponent=\"p\"\n\t\t\t\t\t\t\t\talign=\"center\"\n\t\t\t\t\t\t\t\tdisplay=\"inline\"\n\t\t\t\t\t\t\t>\n\t\t\t\t\t\t\t\t<p className=\"categoryItem\">Город:</p>\n\t\t\t\t\t\t\t\t{MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.{props.userData.city}</p>}\n\t\t\t\t\t\t\t</Typography>\n\t\t\t\t\t\t</Grid>\n\t\t\t\t\t\t<Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\n\t\t\t\t\t\t\t<Typography\n\t\t\t\t\t\t\t\tclassName={classes.root5}\n\t\t\t\t\t\t\t\tvariant=\"body1\"\n\t\t\t\t\t\t\t\tcolor=\"textSecondary\"\n\t\t\t\t\t\t\t\tcomponent=\"p\"\