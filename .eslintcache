-width:950px)')\r\n  return (\r\n    <Card className={classes.root} >\r\n      <CardActionArea >\r\n        <CardContent className={classes.roott} >\r\n          <Grid item xs={12} sm={12} xl={12} lg={12} md={12} container justify=\"center\">\r\n            <Typography gutterBottom variant=\"h5\" component=\"h2\">\r\n              <p className=\"mainTitle\">Контактная информация</p>\r\n            </Typography>\r\n          </Grid>\r\n          <Grid\r\n            container\r\n            direction=\"row\"\r\n            justify=\"space-between\"\r\n            alignItems=\"baseline\"\r\n          >\r\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root1} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                <p className=\"categoryItem\">Email/Соц.сети:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{userData.email}</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root2} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                <p className=\"categoryItem\">Номер телефона:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{userData.phone}</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root3} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                <p className=\"categoryItem\">Дата рождения:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{userData.birthday}</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root4} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\r\n                <p className=\"categoryItem\">Город:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.{userData.city}</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={4} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root5} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\r\n                <p className=\"categoryItem\">Пол:</p>{MobileVersionPlatform && <p className=\"itemsPlatfrom\">{userData.gender==\"Male\"?\"Мужчина\":\"Женщина\"}</p>}\r\n              </Typography>\r\n            </Grid>\r\n          </Grid>\r\n\r\n          <Grid\r\n            container\r\n            direction=\"row\"\r\n            justify=\"space-between\"\r\n            alignItems=\"baseline\"\r\n          >\r\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\">\r\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">emir.azimov@gmail.com</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+996703878545</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">+15.10.1998</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">г.Бишкек</p>}\r\n              </Typography>\r\n            </Grid>\r\n            <Grid item xs={12} sm={2} xl={2} lg={2} md={2}>\r\n              <Typography className={classes.root} variant=\"body1\" color=\"textSecondary\" component=\"p\" align=\"center\" display=\"inline\" >\r\n                {!MobileVersionPlatform && <p className=\"itemsPlatfrom\">Мужчина</p>}\r\n              </Typography>\r\n            </Grid>\r\n          </Grid>\r\n        </CardContent>\r\n      </CardActionArea>\r\n    </Card>\r\n  );\r\n}\r\n","D:\\projects\\react\\normaLK\\src\\components\\News\\Pagination.js",["101","102","103","104","105"],"import React, { useState, useEffect } from 'react'\r\n\r\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\r\n\tconst [counter, setCounter] = useState(1)\r\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\reducers\\index.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\reducers\\getUserData.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\constants.js",[],"D:\\projects\\react\\normaLK\\src\\point.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\actions\\index.js",[],"D:\\projects\\react\\normaLK\\src\\redux\\actions\\getUserData.js",[],{"ruleId":"106","severity":1,"message":"107","line":2,"column":23,"nodeType":"108","messageId":"109","endLine":2,"endColumn":34},{"ruleId":"110","severity":1,"message":"111","line":14,"column":5,"nodeType":"112","endLine":14,"endColumn":35,"suggestions":"113"},{"ruleId":"114","severity":1,"message":"115","line":21,"column":44,"nodeType":"116","messageId":"117","endLine":21,"endColumn":46},{"ruleId":"118","replacedBy":"119"},{"ruleId":"120","replacedBy":"121"},{"ruleId":"106","severity":1,"message":"122","line":3,"column":10,"nodeType":"108","messageId":"109","endLine":3,"endColumn":17},{"ruleId":"106","severity":1,"message":"123","line