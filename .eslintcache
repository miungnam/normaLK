t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],{"ruleId":"98","replacedBy":"99"},{"ruleId":"100","replacedBy":"101"},{"ruleId":"102","severity":1,"message":"103","line":111,"column":8,"nodeType":"104","messageId":"105","endLine":111,"endColumn":13},{"ruleId":"102","severity":1,"message":"106","line":114,"column":9,"nodeType":"104","messageId":"105","endLine":114,"endColumn":13},{"ruleId":"107","severity":1,"message":"108","line":1,"column":1,"nodeType":"109","endLine":3,"endColumn":2},{"ruleId":"102","severity":1,"message":"110","line":2,"column":10,"nodeType":"104","messageId":"105","endLine":2,"endColumn":24},{"ruleId":"102","severity":1,"message":"111","line":7,"column":10,"nodeType":"104","messageId":"105","endLi