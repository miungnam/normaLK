 / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\components\\Profile\\Profile.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Docs\\Docs.js",[],"D:\\projects\\react\\normaLK\\src\\components\\Otchets\\Otchets.js",[],"D:\\projects\\react\\normaLK\\