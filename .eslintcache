item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\index.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\reportWebVitals.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\App.js",["268","269"],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\redux\\reducers\\index.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\redux\\actions\\index.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\components\\Sidebar\\Sidebar.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\redux\\reducers\\getAndLogin.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\components\\Registr\\Registrationn.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\components\\Login\\Login.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\redux\\actions\\getAndLogin.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\redux\\constants.js",[],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\components\\Registr\\Registration.js",["270"],"C:\\Users\\Admin\\Desktop\\normaLK\\src\\components\\Otchets