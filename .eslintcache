n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\My_projects\\projectNewForma\\src\\components\\Footer\\footer.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\containers\\LoginContainer\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\actions\\LoginAction\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\index.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\news\\news.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\Login\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\utils\\base.js",["104"],"export default function (handlers, defaultState = {}) {\r\n    return abstractReducer.bind(null, handlers, defaultState);\r\n}\r\n\r\nfunction abstractReducer(handlers, defaultState, state, action) {\r\n    return handlers[action.type] ? handlers[action.type](state, action) : (state || defaultState);\r\n}\r\n\r\n\r\nexport function updateReducer(oldState, updatedProperties) {\r\n    return {\r\n        ...oldState,\r\n        ...updatedProperties\r\n    }\r\n\r\n}","D:\\My_projects\\projectNewForma\\src\\redux\\actions\\newsAction\\news-action.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\constant\\storage_key.js",[],{"ruleId":"105","replacedBy":"106"},{"ruleId":"107","replacedBy":"108"},{"ruleId":"109","severity":1,"message":"110","line":2,"column":10,"nodeType":"111","messageId":"112","endLine":2,"endColumn":24},{"ruleId":"109","severity":1,"message":"113","line":7,"column":10,"nodeType":"111","messageId":"112","endLine":7,"endColumn":20},{"ruleId":"109","severity":1,"message":"114","line":112,"column":11,"nodeType":"111","messageId":"112","endLine":112,"endColumn":16},{"ruleId":"109","severity":1,"message":"115","line":5,"column":26,"nodeType":"111","messageId":"112","endLine":5,"endColumn":44},{"ruleId":"116","severity":1,"message":"117","line":10,"column":5,"nodeType":"118","endLine":10,"endColumn":14,"suggestions":"119"},{"ruleId":"120","severity":1,"message":"121","line":32,"column":7,"nodeType":"122","endLine":32,"endColumn":100},{"ruleId":"120","severity":1,"message":"121","line":39,"column":8,"nodeType":"122","endLine":43,"endColumn":9},{"ruleId":"120","severity":1,"message":"121","line":49,"column":7,"nodeType":"122","endLine":49,"endColumn":100},{"ruleId":"123","severity":1,"message":"124","line":1,"column":1,"nodeType":"125","endLine":3,"endColumn":2},"no-native-reassign",["126"],"no-negated-in-lhs",["127"],"no-unused-vars","'createMuiTheme' is defined but never used.","Identifier","unusedVar","'withStyles' is defined but never used.","'theme' is assigned a value but never used.","'setNumberOfButoons' is assigned a value but never used.","react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'onPaginationChange' and 'showPerPage'. Either include them or remove the dependency array. If 'onPaginationChange' changes too often, find the parent component that defines it and wrap that definition in useCallback.","ArrayExpress