em\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\projects\\react\\normaLK\\src\\products.js",[],{"ruleId":"155","severity":1,"message":"156","line":18,"column":5,"nodeType":"157","endLine":18,"endColumn":73,"suggestions":"158"},{"ruleId":"155","severity":1,"message":"159","line":18,"column":15,"nodeType":"160","endLine":18,"endColumn":51},{"ruleId":"161","severity":1,"message":"162","line":7,"column":22,"nodeType":"163","messageId":"164","endLine":7,"endColumn":30},{"ruleId":"165","severity":1,"message":"166","line":256,"column":12,"nodeType":"167","messageId":"168","endLine":256,"endColumn":16},{"ruleId":"165","severity":1,"message":"169","line":257,"column":12,"nodeType":"167","messageId":"168","endLine":257,"endColumn":16},{"ruleId":"165","severity":1,"message":"170","line":258,"column":12,"nodeType":"167","messageId":"168","endLine":258,"endColumn":16},{"ruleId":"161","severity":1,"message":"171","line":6,"column":8,"nodeType":"163","messageId":"164","endLine":6,"endColumn":14},{"ruleId":"161","severity":1,"mess