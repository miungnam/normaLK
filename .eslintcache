\r\n                <Box pb={2}>\r\n                    <Button\r\n                        onClick={actions.login}\r\n                        variant=\"contained\"\r\n                        color=\"primary\"\r\n                        type=\"submit\"\r\n                    >\r\n                        Войти\r\n                    </Button>\r\n                </Box>\r\n            </Card>\r\n        </div>\r\n    );\r\n}\r\nexport default Login","D:\\My_projects\\projectNewForma\\src\\components\\Registr\\Registration.js",[],"D:\\My_projects\\projectNewForma\\src\\components\\News\\News.js",[],"D:\\My_projects\\projectNewForma\\src\\components\\ContactInfo\\ContactInfo.js",["93","94"],"D:\\My_projects\\projectNewForma\\src\\components\\Header\\Header.js",[],"D:\\My_projects\\projectNewForma\\src\\components\\Sidebar\\Sidebar.js",["95","96","97"],"D:\\My_projects\\projectNewForma\\src\\products.js",[],"D:\\My_projects\\projectNewForma\\src\\components\\News\\Pagination.js",["98","99","100","101","102"],"import React, { useState, useEffect } from 'react'\r\n\r\nconst Pagination = ({ showPerPage, onPaginationChange, total }) => {\r\n\tconst [counter, setCounter] = useState(1)\r\n\tconst [numberOfButtons, setNumberOfButoons] = useState(Math.ceil(total / showPerPage))\r\n\r\n\tuseEffect(() => {\r\n\t\tconst value = showPerPage * counter\r\n\t\tonPaginationChange(value - showPerPage, value)\r\n\t}, [counter])\r\n\r\n\tconst onButtonClick = (type) => {\r\n\t\tif (type === 'prev') {\r\n\t\t\tif (counter === 1) {\r\n\t\t\t\tsetCounter(1)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter - 1)\r\n\t\t\t}\r\n\t\t} else if (type === 'next') {\r\n\t\t\tif (numberOfButtons === counter) {\r\n\t\t\t\tsetCounter(counter)\r\n\t\t\t} else {\r\n\t\t\t\tsetCounter(counter + 1)\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\treturn (\r\n\t\t<div className=\"d-flex justify-content-center\">\r\n\t\t\t<nav aria-label=\"Page navigation example\">\r\n\t\t\t\t<ul className=\"pagination\">\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('prev')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-left\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\r\n\t\t\t\t\t{new Array(numberOfButtons).fill('').map((el, index) => (\r\n\t\t\t\t\t\t<li key={index} className={`page-item ${index + 1 === counter ? 'active' : null}`}>\r\n\t\t\t\t\t\t\t<a\r\n\t\t\t\t\t\t\t\tstyle={{ cursor: 'pointer' }}\r\n\t\t\t\t\t\t\t\tclassName=\"page-link\"\r\n\t\t\t\t\t\t\t\tonClick={() => setCounter(index + 1)}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{index + 1}\r\n\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t</li>\r\n\t\t\t\t\t))}\r\n\t\t\t\t\t<li className=\"page-item\">\r\n\t\t\t\t\t\t<a style={{ cursor: 'pointer' }} className=\"page-link\" onClick={() => onButtonClick('next')}>\r\n\t\t\t\t\t\t\t<i className=\"fas fa-arrow-right\"></i>\r\n\t\t\t\t\t\t</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</nav>\r\n\t\t</div>\r\n\t)\r\n}\r\n\r\nexport default Pagination\r\n","D:\\My_projects\\projectNewForma\\src\\components\\Footer\\footer.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\containers\\LoginContainer\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\actions\\LoginAction\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\index.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\news\\news.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\Login\\login.js",[],"D:\\My_projects\\projectNewForma\\src\\redux\\reducers\\utils\\base.js",["103"],"export default function (handlers, defaultState = {}) {\r\n    return abstractReducer.bind(null, handlers, defaultState);\r\n}\r\n\r\nfunction abstractReducer(handlers, defaultState, state, action) {\r\n    return handlers[action.type] ? handlers[action.type](state, action) : (state || defaultState);\r\n}\r\n\r\n\r\nexport function updateReducer(oldState, updatedProperties) {\r\n    return {\r\n        ...oldState,\r\n    